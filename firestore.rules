rules_version = '2';

// Beerlist: registro abierto, solo mayores de edad que aceptan las condiciones.
// - Para ver hace falta cuenta y perfil (/members/{uid}).
// - Para publicar, valorar o usar mesas hace falta además el correo confirmado.
// - Cada usuario solo modifica lo suyo; los administradores (/admins/{uid}) pueden retirar contenido.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // ---------- Administradores (se dan de alta a mano en la consola) ----------
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Perfiles ----------
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;

      // Alta: nombre visible, mayoría de edad y aceptación de condiciones.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'adult', 'acceptedTermsAt', 'createdAt'])
        && isString(request.resource.data.name, 1, 30)
        && request.resource.data.adult == true
        && request.resource.data.acceptedTermsAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && isString(request.resource.data.name, 1, 30);

      // Borrar la cuenta (derecho de supresión).
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Cervezas ----------
    match /beers/{beerId} {
      allow read: if isMember();

      allow create: if isMember() && verified()
        && request.resource.data.keys().hasOnly(['name', 'imageUrl', 'imagePath', 'createdAt', 'createdBy', 'createdByName', 'ratings'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isString(request.resource.data.name, 1, 80)
        && isString(request.resource.data.createdByName, 1, 30)
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('https://.+')
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath.matches('beers/' + request.auth.uid + '/.+')
        && request.resource.data.ratings == {};

      // Valorar: cada uno solo toca SU nota. Añadir o cambiar requiere correo confirmado.
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings'])
        && request.resource.data.get('ratings', {}).diff(resource.data.get('ratings', {})).affectedKeys().hasOnly([request.auth.uid])
        && validRating(request.resource.data.get('ratings', {}));

      // Moderación: un administrador puede quitar notas, pero no añadir ni cambiar ninguna.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings'])
        && request.resource.data.get('ratings', {}).diff(resource.data.get('ratings', {})).addedKeys().size() == 0
        && request.resource.data.get('ratings', {}).diff(resource.data.get('ratings', {})).changedKeys().size() == 0;

      allow delete: if isMember() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    function validRating(ratings) {
      return !(request.auth.uid in ratings) || (
        verified()
        && ratings[request.auth.uid].keys().hasOnly(['rating', 'comment', 'name', 'updatedAt'])
        && ratings[request.auth.uid].rating is int
        && ratings[request.auth.uid].rating >= 1
        && ratings[request.auth.uid].rating <= 5
        && isString(ratings[request.auth.uid].comment, 0, 500)
        && isString(ratings[request.auth.uid].name, 1, 30)
      );
    }

    // ---------- Denuncias (ID = "<quien denuncia>__<cerveza>__<comentario|post>") ----------
    match /reports/{reportId} {
      allow create: if isMember()
        && reportId.matches(request.auth.uid + '__.+')
        && request.resource.data.keys().hasOnly(['beerId', 'beerName', 'reviewUid', 'reviewName', 'reviewText', 'reason', 'details', 'reporterUid', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason in ['ofensivo', 'spam', 'no-cerveza', 'datos-personales', 'otro']
        && isString(request.resource.data.details, 0, 300)
        && isString(request.resource.data.reviewText, 0, 500);

      allow read, delete: if isAdmin();
    }

    // ---------- Mesas (el ID del documento es el código de 6 caracteres) ----------
    match /tables/{code} {
      allow get: if isMember();
      allow list: if isMember() && request.auth.uid in resource.data.memberIds;

      allow create: if isMember() && verified()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'ownerName', 'createdAt', 'memberIds', 'members'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isString(request.resource.data.name, 1, 40)
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);

      // Unirse (requiere correo confirmado) o "pagar la cuenta": cada uno solo se mueve a sí mismo.
      // El creador no sale: cierra la mesa.
      allow update: if isMember()
        && request.auth.uid != resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
        && onlySelfChanged()
        && (!(request.auth.uid in request.resource.data.memberIds) || verified())
        && request.resource.data.memberIds.size() <= 50;

      allow delete: if isMember() && resource.data.ownerId == request.auth.uid;
    }

    function onlySelfChanged() {
      let before = resource.data.memberIds.toSet();
      let after = request.resource.data.memberIds.toSet();
      return after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
    }
  }
}
